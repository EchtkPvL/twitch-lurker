twitch:
  access_token: "your-access-token"
  # username: optional_override
  # match_mode: contains
  sub_gift_reply: "@{user} !!! bleedPurple CurseLit :>"
  refresh_interval: 18h
  batch_size: 95
  keywords: []
  # keywords:
  #   - simple_keyword
  #   - word: ExactMatch
  #     mode: exact
  # Lurk in top live streams. Omit this section to disable.
  # top_streams:
  #   languages: [de, en]       # optional, ISO 639-1 codes
  #   game_ids: []               # optional, Twitch category IDs
  #   batches: 2                 # default: 2 (2 * batch_size channels)
  #   refresh_interval: 30m      # default: 30m
  ignore_users:
    - streamelements
    - nightbot
  ignore_channels: []

telegram:
  bot_token: "your-telegram-bot-token"
  chat_id: 123456789

verbose: false
